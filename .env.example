# ─────────────────────────────────────────────────────────────────────────────
# Pagatu MCP — variables de entorno
#
# Este archivo documenta TODAS las variables. No contiene ningún valor real y
# es el único de la familia .env/.dev.vars que se versiona.
#
# En local: copia a `.dev.vars` (lo lee `wrangler dev`, está en .gitignore).
# En producción: las NO secretas viven en `wrangler.jsonc` → `vars`, y las
# secretas se cargan con `wrangler secret put <NOMBRE>`.
# ─────────────────────────────────────────────────────────────────────────────

# ─── SECRETOS (wrangler secret put) ─────────────────────────────────────────

# Clave secreta de Clerk de la MISMA instancia que usa la app de Pagatu.
# Se usa para dos cosas: verificar el access token OAuth del cliente MCP y
# firmar el JWT del template de Convex del usuario. Nunca sale del Worker.
# Producción: sk_live_… · Desarrollo: sk_test_…
CLERK_SECRET_KEY="sk_test_..."

# ─── CONFIGURACIÓN (wrangler.jsonc → vars, o .dev.vars en local) ────────────

# Issuer de Clerk: el mismo valor que CLERK_JWT_ISSUER_DOMAIN en Convex.
# Es, además, el Authorization Server que se anuncia a los clientes MCP.
# Ej.: https://clerk.pagatu.io  o  https://<instancia>.clerk.accounts.dev
CLERK_JWT_ISSUER_DOMAIN="https://clerk.pagatu.io"

# URL del despliegue de Convex de Pagatu (el mismo que NEXT_PUBLIC_CONVEX_URL
# de la app). El MCP no crea ni toca otra base de datos.
CONVEX_URL="https://<despliegue>.convex.cloud"

# URL pública de este Worker. Se publica en los metadatos OAuth, así que tiene
# que ser exactamente la que usan los clientes (sin barra final).
PAGATU_MCP_PUBLIC_URL="https://mcp.pagatu.io"

# URL de la app de Pagatu. Solo se usa para construir enlaces y mensajes
# («inicia sesión en …»).
PAGATU_APP_URL="https://app.pagatu.io"

# ─── OPCIONALES ─────────────────────────────────────────────────────────────

# Nombre del JWT template de Clerk que entiende Convex. Por defecto `convex`,
# que es el que ya existe para la app.
# CLERK_CONVEX_JWT_TEMPLATE="convex"

# `false` deja el servidor en modo SOLO LECTURA: las herramientas que escriben
# (crear cliente, crear cotización) no se registran ni aparecen en tools/list.
# PAGATU_MCP_WRITE_ENABLED="true"

# Lista blanca de client_id de OAuth, separados por comas. Vacío = cualquier
# cliente que Clerk haya autorizado. Útil para restringir el MCP a Claude y
# Codex una vez conocidos sus client_id.
# PAGATU_MCP_ALLOWED_CLIENT_IDS=""

# debug | info | warn | error
# PAGATU_MCP_LOG_LEVEL="info"

# Token de verificación de dominio del directorio de apps de OpenAI. Lo da su
# panel al conectar el servidor MCP; el Worker lo sirve tal cual en
# /.well-known/openai-apps-challenge. Vacío = esa ruta devuelve 404.
# OPENAI_APPS_CHALLENGE=""

# Base de la Backend API de Clerk. Solo se cambia en pruebas.
# CLERK_API_URL="https://api.clerk.com"
