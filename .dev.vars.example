# Copia este archivo a `.dev.vars` (ignorado por git) para `npm run dev`.
# La descripción completa de cada variable está en `.env.example`.
#
# En local el Worker habla con la Clerk y el Convex REALES de desarrollo: usa
# una instancia de desarrollo (sk_test_…) y el despliegue `dev:` de Convex,
# nunca los de producción.

CLERK_SECRET_KEY="sk_test_..."
CLERK_JWT_ISSUER_DOMAIN="https://<instancia>.clerk.accounts.dev"
CONVEX_URL="https://<despliegue-dev>.convex.cloud"
PAGATU_MCP_PUBLIC_URL="http://localhost:8787"
PAGATU_APP_URL="http://localhost:4321"
PAGATU_MCP_WRITE_ENABLED="true"
PAGATU_MCP_LOG_LEVEL="debug"
