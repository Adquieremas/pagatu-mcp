{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pagatu-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  // nodejs_compat: el SDK oficial de MCP importa módulos de Node (node:crypto,
  // node:stream) incluso en el transporte Web Standard.
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  // Smart Placement: que el Worker se ejecute cerca de Clerk y Convex, no del
  // visitante.
  //
  // Cada petición MCP encadena hasta tres llamadas salientes —verificar el
  // token, firmar el JWT de plantilla, consultar Convex— y todas van a
  // Estados Unidos. Sin esto, desde Lima esos tres saltos cruzan el continente
  // uno detrás de otro; con esto, lo cruza solo la petición del cliente y las
  // tres llamadas quedan cortas.
  //
  // Estaba activado en el dashboard y los primeros despliegues desde este
  // archivo lo borraron: la configuración local sobrescribe la remota, así que
  // lo que no esté declarado aquí se pierde. Por eso vive en el repositorio.
  // Cloudflare necesita algo de tráfico antes de decidir dónde colocarlo.
  "placement": {
    "mode": "smart"
  },
  "observability": {
    "enabled": true
  },
  // Variables NO secretas de PRODUCCIÓN. El único secreto es CLERK_SECRET_KEY,
  // que se carga con `wrangler secret put CLERK_SECRET_KEY` (ver README).
  //
  // Los tres valores de identidad —issuer de Clerk, Convex y la clave secreta—
  // tienen que ser del MISMO entorno. Aquí son los de producción:
  // clerk.pagatu.io + peaceful-swordfish-460 + sk_live_…
  // Para desarrollo NO se tocan estos: `wrangler dev` lee `.dev.vars`, que
  // apunta al instance de Clerk de dev y al deployment peaceful-woodpecker-797.
  "vars": {
    "CLERK_JWT_ISSUER_DOMAIN": "https://clerk.pagatu.io",
    "CONVEX_URL": "https://peaceful-swordfish-460.convex.cloud",
    "PAGATU_MCP_PUBLIC_URL": "https://mcp.pagatu.io",
    "PAGATU_APP_URL": "https://app.pagatu.io",
    "PAGATU_MCP_WRITE_ENABLED": "true",
    "PAGATU_MCP_LOG_LEVEL": "info",
    // Verificación de dominio del directorio de apps de OpenAI. No es un
    // secreto: el Worker lo sirve públicamente en
    // /.well-known/openai-apps-challenge, que es justo lo que OpenAI compara.
    "OPENAI_APPS_CHALLENGE": "km_69yPFypll6IYLcweZxxOa5ENTyc2VKd2J-PX7aSU"
  },
  "routes": [
    {
      "pattern": "mcp.pagatu.io",
      "custom_domain": true
    }
  ]
}

