{
  "name": "pagatu-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Servidor MCP remoto de Pagatu.io (Cloudflare Workers + Streamable HTTP) sobre el backend Convex existente",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:dry": "wrangler deploy --dry-run --outdir=.wrangler/dry-run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:clerk": "node scripts/check-clerk.mjs",
    "check": "npm run typecheck && npm run lint && npm run test",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "convex": "^1.50.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261116.1",
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^4.1.12",
    "wrangler": "^4.162.0"
  }
}
